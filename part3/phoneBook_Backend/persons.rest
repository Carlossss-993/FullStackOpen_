###

# Get every person on DB
GET http://localhost:3002/api/persons

###

# Get a person who exists on DB
GET http://localhost:3002/api/persons/6a83962792f6bd6624916bf8

###

# Get a person who does not exist on DB
GET http://localhost:3002/api/persons/6a83962792f6bd6624916bf7

###

# Get a person with a malformatted id on DB
GET http://localhost:3002/api/persons/1

###

# Delete a person who exists on DB
DELETE http://localhost:3002/api/persons/6a83a7d51c2944e1daab97b3

###

# Delete a person who does not exist on DB
DELETE http://localhost:3002/api/persons/6a839804e81534c9f0a8c428

###

# Delete a person with a malformatted id on DB
DELETE http://localhost:3002/api/persons/1

###

# Post a person
POST http://localhost:3002/api/persons
Content-Type: application/json

{
    "name": "Celeste",
    "number": "549-999"
}

###

# Post a person with no number
POST http://localhost:3002/api/persons
Content-Type: application/json

{
    "name": "Haz"
}

###

# Update a person who exists
PUT http://localhost:3002/api/persons/6a83a97d6815abd7cc9ca835
Content-Type: application/json

{
    "name": "Haz",
    "number": "521-888"
}

###

# Update a person who does not exist
PUT http://localhost:3002/api/persons/6a83a97d6815abd7cc9ca834
Content-Type: application/json

{
    "name": "Haz",
    "number": "521-888"
}

###

# Update a person with a malformatted id
PUT http://localhost:3002/api/persons/1
Content-Type: application/json

{
    "name": "Haz",
    "number": "521-888"
}